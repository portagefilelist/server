<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.portagefilelist.de/xsd/collect" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.portagefilelist.de/xsd/collect">

    <element name="pfl" type="tns:categories" />

    <complexType name="categories">
        <sequence>
            <element name="category" type="tns:category" maxOccurs="unbounded" minOccurs="1" />
        </sequence>
    </complexType>

    <complexType name="category">
        <sequence>
            <element name="package" type="tns:package" maxOccurs="unbounded" minOccurs="0"/>
        </sequence>
        <attribute name="name" type="string" use="required" />
    </complexType>

    <complexType name="package">
        <sequence>
            <element name="files" type="tns:files" maxOccurs="1" minOccurs="1" />
            <element name="uses" type="tns:uses" maxOccurs="1" minOccurs="0" />
        </sequence>
        <attribute name="name" type="string" use="required" />
        <attribute name="version" type="string" use="required" />
        <attribute name="arch" type="string" use="required" />
        <attribute name="timestamp" type="float" use="required" />
        <attribute name="repo" type="string" />
    </complexType>

    <complexType name="files">
        <sequence>
            <element name="file" type="tns:file" maxOccurs="unbounded" minOccurs="1" />
        </sequence>
    </complexType>

    <complexType name="file">
        <simpleContent>
            <extension base="string">
                <attribute name="type" type="tns:typeSimpleType" />
            </extension>
        </simpleContent>
    </complexType>

    <complexType name="uses">
        <sequence>
            <element name="use" type="string" maxOccurs="unbounded" minOccurs="1" />
        </sequence>
    </complexType>

    <simpleType name="typeSimpleType">
        <restriction base="string">
            <enumeration value="sym" />
            <enumeration value="obj" />
            <enumeration value="dir" />
            <enumeration value="fif" />
            <enumeration value="dev" />
        </restriction>
    </simpleType>
</schema>
